#!/bin/sh
# Block direct pushes to main. Branch + open a PR instead (see CONTRIBUTING.md).
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "BLOCKED: direct pushes to the default branch are not allowed — branch and open a PR (CONTRIBUTING.md)." >&2
      echo "         (deliberate override only: git push --no-verify)" >&2
      exit 1 ;;
  esac
done
exit 0
